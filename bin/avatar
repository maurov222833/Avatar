#!/usr/bin/env python3
"""`avatar config check`. No activa capacidades."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

if __name__ == "__main__":
    if sys.argv[1:3] == ["seal-key", "regenerate"]:
        from core.state_db import regenerate_seal_key_cli
        sys.exit(regenerate_seal_key_cli(sys.argv[3:]))
    from core.avatar_config import main
    sys.exit(main(sys.argv[1:]))
